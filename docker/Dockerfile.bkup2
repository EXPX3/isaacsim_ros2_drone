FROM nvcr.io/nvidia/isaac-sim:5.1.0

ENV DEBIAN_FRONTEND=noninteractive
ENV DEBCONF_NOWARNINGS=yes

USER root

# ------------------------------------------------------------
# 1. System dependencies (apt)
# ------------------------------------------------------------
RUN set -x && \
    apt-get update -y -qq && \
    apt-get upgrade -y -qq --no-install-recommends && \
    apt-get install -y -qq \
        libyaml-cpp-dev curl software-properties-common \
        vim v4l-utils exfat-* exfat-fuse \
        openssh-server \
        terminator dbus-x11 \
        python3-pip python3.12-venv \
    && apt-get autoremove -y -qq \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 2. CMake (Kitware repo)
# ------------------------------------------------------------
RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | \
    gpg --dearmor - | tee /etc/apt/trusted.gpg.d/kitware.gpg >/dev/null && \
    apt-add-repository "deb https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" && \
    apt update && \
    apt install -y -qq cmake && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 3. Universe repo + common tools
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y \
        curl gnupg2 lsb-release \
    && add-apt-repository universe \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 4. ROS 2 Jazzy repository
# ------------------------------------------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list

# ------------------------------------------------------------
# 5. Install ROS 2 Jazzy + Robotics Packages
# ------------------------------------------------------------
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        mesa-utils libglu1-mesa-dev freeglut3-dev mesa-common-dev \
        libglew-dev libglfw3-dev libglm-dev libao-dev libmpg123-dev libasio-dev \
        \
        ros-jazzy-desktop \
        ros-jazzy-ament-cmake \
        ros-jazzy-angles \
        ros-jazzy-controller-manager \
        ros-jazzy-pluginlib \
        ros-jazzy-urdf \
        ros-jazzy-yaml-cpp-vendor \
        ros-jazzy-joint-state-publisher \
        ros-jazzy-joint-state-publisher-gui \
        ros-jazzy-cv-bridge \
        ros-jazzy-diagnostic-updater \
        ros-jazzy-moveit \
        ros-jazzy-xacro \
        ros-jazzy-realtime-tools \
        ros-jazzy-control-toolbox \
        ros-jazzy-ros2-control \
        ros-jazzy-ros2-controllers \
        ros-jazzy-teleop-twist-keyboard \
        ros-jazzy-vision-msgs \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 6. Additional tools
# ------------------------------------------------------------
RUN apt-get update && apt-get install -q -y --no-install-recommends \
        dirmngr gnupg2 lsb-release \
        python3-colcon-ros \
        telnet nano git make \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 8. Isaac Sim environment setup in ~/.bashrc
# ------------------------------------------------------------
RUN cat <<'EOF' >> /root/.bashrc

# ---------------------------
# ISAAC SIM SETUP
# ---------------------------
export ISAACSIM_PATH="/isaac-sim"
export ISAACSIM_PYTHON="${ISAACSIM_PATH}/python.sh"
export ISAACSIM="${ISAACSIM_PATH}/isaac-sim.sh"

isaac_run() {
    if [ ! -x "$ISAACSIM_PYTHON" ]; then
        echo "IsaacSim python.sh not found at: $ISAACSIM_PYTHON"
        return 1
    fi
    if [ ! -x "$ISAACSIM" ]; then
        echo "IsaacSim launcher not found at: $ISAACSIM"
        return 1
    fi

    unset ROS_VERSION ROS_PYTHON_VERSION ROS_DISTRO AMENT_PREFIX_PATH COLCON_PREFIX_PATH PYTHONPATH CMAKE_PREFIX_PATH

    local ros_paths=()
    ros_paths+=("/opt/ros/humble")
    ros_paths+=("/opt/ros/jazzy")
    ros_paths+=("/opt/ros/iron")
    for ros_path in "${ros_paths[@]}"; do
        export LD_LIBRARY_PATH=$(echo "$LD_LIBRARY_PATH" | tr ':' '\n' | grep -v "^${ros_path}" | paste -sd':' -)
    done

    if [ -f /etc/os-release ]; then
        UBUNTU_VERSION=$(grep "^VERSION_ID=" /etc/os-release | cut -d'"' -f2)
    fi

    if [[ "$UBUNTU_VERSION" == "24.04" ]]; then
        export ROS_DISTRO=jazzy
        export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${ISAACSIM_PATH}/exts/isaacsim.ros2.bridge/jazzy/lib"
        echo "Detected Ubuntu 24.04 -> Using ROS_DISTRO=jazzy"
    else
        export ROS_DISTRO=humble
        export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${ISAACSIM_PATH}/exts/isaacsim.ros2.bridge/humble/lib"
        echo "Detected Ubuntu ${UBUNTU_VERSION:-unknown} -> Using ROS_DISTRO=humble"
    fi

    if [ $# -eq 0 ]; then
        echo "Launching Isaac Sim GUI..."
        "${ISAACSIM}"
    elif [[ "$1" == --* ]]; then
        echo "Launching Isaac Sim with options: $*"
        "${ISAACSIM}" "$@"
    elif [ -f "$1" ]; then
        local SCRIPT_PATH="$1"
        shift
        echo "Running Python script with Isaac Sim: $SCRIPT_PATH"
        "${ISAACSIM_PYTHON}" "$SCRIPT_PATH" "$@"
    else
        echo "Unknown argument or file not found: '$1'"
        return 1
    fi
}

export PATH="/opt/venv/bin:$PATH"
export PYTHONPATH="/opt/venv/lib/python3.11/site-packages:$PYTHONPATH"
EOF

# ------------------------------------------------------------
# 9. Clone & setup Pegasus Simulator (editable install)
# ------------------------------------------------------------
WORKDIR /root
RUN export ISAACSIM_PATH="/isaac-sim" && \
    git clone https://github.com/PegasusSimulator/PegasusSimulator.git && \
    mkdir -p PegasusSimulator/extensions/pegasus.simulator && \
    echo "[build-system]" > PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    echo "requires = [\"setuptools\", \"wheel\", \"toml\"]" >> PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    echo "build-backend = \"setuptools.build_meta\"" >> PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    cd PegasusSimulator/extensions/pegasus.simulator && \
    /isaac-sim/python.sh -m pip install --editable .

# ------------------------------------------------------------
# 10. Clone PX4-Autopilot
# ------------------------------------------------------------
WORKDIR /root
RUN git clone https://github.com/PX4/PX4-Autopilot.git && \
    cd PX4-Autopilot && \
    git checkout v1.14.3 && \
    git submodule update --init --recursive
# ------------------------------------------------------------
# 3. Create venv + install deps + build PX4
# ------------------------------------------------------------
RUN set -e && \
    # 3.1 Create venv with Isaac Sim Python
    /isaac-sim/python.sh -m venv /opt/venv && \
    \
    # 3.2 Activate
    export PATH="/opt/venv/bin:$PATH" && \
    export PYTHONPATH="/opt/venv/lib/python3.11/site-packages:$PYTHONPATH" && \
    \
    # 3.3 Install deps
    /opt/venv/bin/pip install --upgrade pip setuptools wheel && \
    /opt/venv/bin/pip install --no-cache-dir \
        pyros-genmsg kconfiglib jinja2 empy jsonschema packaging toml numpy future argcomplete && \
    \
    # 3.4 Verify kconfiglib
    python3 -c "import kconfiglib; print('kconfiglib OK')" && \
    \
    # 3.5 Build PX4
    cd /root/PX4-Autopilot && \
    make distclean && \
    \
    # FORCE cmake to use venv Python
    cmake -B build/px4_sitl_default \
          -S . \
          -DPython3_EXECUTABLE=/opt/venv/bin/python3 \
          -DCMAKE_BUILD_TYPE=Release && \
    \
    make -C build/px4_sitl_default px4_sitl_default && \
    \
    ls -l build/px4_sitl_default/bin/px4 && \
    echo "PX4 SITL BUILD SUCCESSFUL"

# ------------------------------------------------------------
# 11. QGroundControl
# ------------------------------------------------------------
RUN apt-get update && apt-get install -y \
        libqt5gui5 libfuse2 fuse gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-gl \
    && rm -rf /var/lib/apt/lists/*
RUN if dpkg -l | grep -q modemmanager; then apt-get remove --purge -y modemmanager; else echo "modemmanager not installed, skipping"; fi
WORKDIR /home/ubuntu
RUN wget https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage && \
    chmod +x QGroundControl-x86_64.AppImage
RUN usermod -a -G dialout ubuntu

# ------------------------------------------------------------
# 12. tmux + config
# ------------------------------------------------------------
RUN apt-get update && \
    apt-get install -y tmux && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/.tmux/plugins && \
    git clone https://github.com/tmux-plugins/tpm /root/.tmux/plugins/tpm
RUN mkdir -p /root && \
    wget -O /root/.tmux.conf https://raw.githubusercontent.com/SasaKuruppuarachchi/SasaKuruppuarachchi/main/.tmux.conf && \
    echo 'alias tmuxsrc="tmux source ~/.tmux.conf"' >> /root/.bashrc

# ------------------------------------------------------------
# 13. Final bash setup
# ------------------------------------------------------------
RUN echo 'source /opt/ros/jazzy/setup.bash' >> /root/.bashrc

# ------------------------------------------------------------
# 14. Cleanup
# ------------------------------------------------------------
RUN apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ------------------------------------------------------------
# 15. Default entrypoint
# ------------------------------------------------------------
WORKDIR /root
ENTRYPOINT ["/bin/bash"]