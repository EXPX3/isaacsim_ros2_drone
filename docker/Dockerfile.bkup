FROM nvcr.io/nvidia/isaac-sim:5.1.0

ENV DEBIAN_FRONTEND=noninteractive
# install dependencies via apt
ENV DEBCONF_NOWARNINGS=yes

USER root
# install dependencies via apt
RUN set -x && \
  apt-get update -y -qq && \
  apt-get upgrade -y -qq --no-install-recommends && \
  apt-get install -y -qq \
    libyaml-cpp-dev curl software-properties-common \
    vim v4l-utils exfat-* \
    openssh-server \
    terminator dbus-x11 \
    python3-pip && \
  : "remove cache" && \
  apt-get autoremove -y -qq && \
  rm -rf /var/lib/apt/lists/*

RUN wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /etc/apt/trusted.gpg.d/kitware.gpg >/dev/null && \
    apt-add-repository "deb https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" && \
    apt update && \
    apt install -y -qq cmake

    # Install common tools and enable universe repo
RUN apt-get update && apt-get install -y \
    software-properties-common \
    curl \
    gnupg2 \
    lsb-release \
    && add-apt-repository universe \
    && apt-get update \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# 3. Add ROS 2 Jazzy repository (noble)
# ------------------------------------------------------------
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list

# ------------------------------------------------------------
# 4. Install ROS 2 Jazzy + your extra packages
# ------------------------------------------------------------
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        # ---- graphics / audio libs you wanted (most already in Isaac Sim) ----
        mesa-utils libglu1-mesa-dev freeglut3-dev mesa-common-dev \
        libglew-dev libglfw3-dev libglm-dev libao-dev libmpg123-dev libasio-dev \
        \
        # ---- ROS 2 Jazzy -------------------------------------------------
        ros-jazzy-desktop \
        \
        # Build & core tools
        ros-jazzy-ament-cmake \
        \
        # Robot-specific
        ros-jazzy-angles \
        ros-jazzy-controller-manager \
        ros-jazzy-pluginlib \
        ros-jazzy-urdf \
        ros-jazzy-yaml-cpp-vendor \
        \
        # Joint state (exact names, no glob)
        ros-jazzy-joint-state-publisher \
        ros-jazzy-joint-state-publisher-gui \
        \
        # Vision & diagnostics
        ros-jazzy-cv-bridge \
        ros-jazzy-diagnostic-updater \
        \
        # Motion planning
        ros-jazzy-moveit \
        \
        # Additional packages you listed
        ros-jazzy-xacro \
        ros-jazzy-realtime-tools \
        ros-jazzy-control-toolbox \
        ros-jazzy-ros2-control \
        ros-jazzy-ros2-controllers \
        ros-jazzy-teleop-twist-keyboard \
        ros-jazzy-vision-msgs \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -q -y --no-install-recommends \
    dirmngr \
    gnupg2 \
    lsb-release \
    python3-colcon-ros \
    telnet \
    nano \
    && apt-get clean

WORKDIR /root
RUN apt install git make cmake python3-pip python3.12-venv -y
RUN apt install python3-kconfiglib python3-jinja2 python3-empy python3-jsonschema python3-packaging python3-toml python3-numpy python3-future

RUN cat <<'EOF' >> /root/.bashrc

# ---------------------------
# ISAAC SIM SETUP
# ---------------------------
export ISAACSIM_PATH="/isaac-sim"
export ISAACSIM_PYTHON="${ISAACSIM_PATH}/python.sh"
export ISAACSIM="${ISAACSIM_PATH}/isaac-sim.sh"

isaac_run() {
    if [ ! -x "$ISAACSIM_PYTHON" ]; then
        echo "IsaacSim python.sh not found at: $ISAACSIM_PYTHON"
        return 1
    fi
    if [ ! -x "$ISAACSIM" ]; then
        echo "IsaacSim launcher not found at: $ISAACSIM"
        return 1
    fi

    unset ROS_VERSION ROS_PYTHON_VERSION ROS_DISTRO AMENT_PREFIX_PATH COLCON_PREFIX_PATH PYTHONPATH CMAKE_PREFIX_PATH

    local ros_paths=()
    ros_paths+=("/opt/ros/humble")
    ros_paths+=("/opt/ros/jazzy")
    ros_paths+=("/opt/ros/iron")
    for ros_path in "${ros_paths[@]}"; do
        export LD_LIBRARY_PATH=$(echo "$LD_LIBRARY_PATH" | tr ':' '\n' | grep -v "^${ros_path}" | paste -sd':' -)
    done

    if [ -f /etc/os-release ]; then
        UBUNTU_VERSION=$(grep "^VERSION_ID=" /etc/os-release | cut -d'"' -f2)
    fi

    if [[ "$UBUNTU_VERSION" == "24.04" ]]; then
        export ROS_DISTRO=jazzy
        export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${ISAACSIM_PATH}/exts/isaacsim.ros2.bridge/jazzy/lib"
        echo "Detected Ubuntu 24.04 -> Using ROS_DISTRO=jazzy"
    else
        export ROS_DISTRO=humble
        export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${ISAACSIM_PATH}/exts/isaacsim.ros2.bridge/humble/lib"
        echo "Detected Ubuntu ${UBUNTU_VERSION:-unknown} -> Using ROS_DISTRO=humble"
    fi

    if [ $# -eq 0 ]; then
        echo "Launching Isaac Sim GUI..."
        "${ISAACSIM}"
    elif [[ "$1" == --* ]]; then
        echo "Launching Isaac Sim with options: $*"
        "${ISAACSIM}" "$@"
    elif [ -f "$1" ]; then
        local SCRIPT_PATH="$1"
        shift
        echo "Running Python script with Isaac Sim: $SCRIPT_PATH"
        "${ISAACSIM_PYTHON}" "$SCRIPT_PATH" "$@"
    else
        echo "Unknown argument or file not found: '$1'"
        echo "Usage:"
        echo "  isaac_run                 -> launch GUI"
        echo "  isaac_run my_script.py    -> run script with IsaacSim Python"
        echo "  isaac_run --headless ...  -> launch IsaacSim with CLI flags"
        return 1
    fi
}
EOF

# Drone dev
WORKDIR /root
# Clone and patch Pegasus with pyproject.toml for editable install
# Set ISAACSIM_PATH and clone/install Pegasus Simulator
RUN export ISAACSIM_PATH="/isaac-sim" && \
    git clone https://github.com/PegasusSimulator/PegasusSimulator.git && \
    mkdir -p PegasusSimulator/extensions/pegasus.simulator && \
    echo "[build-system]" > PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    echo "requires = [\"setuptools\", \"wheel\", \"toml\"]" >> PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    echo "build-backend = \"setuptools.build_meta\"" >> PegasusSimulator/extensions/pegasus.simulator/pyproject.toml && \
    cd PegasusSimulator/extensions/pegasus.simulator && \
    /isaac-sim/python.sh -m pip install --editable .


WORKDIR /root
RUN git clone https://github.com/PX4/PX4-Autopilot.git
WORKDIR /root/PX4-Autopilot/
RUN git checkout v1.14.3
RUN git submodule update --init --recursive

# Install QGroundControl and configure user
WORKDIR /root
#RUN usermod -a -G dialout $USER
RUN apt-get remove modemmanager -y
RUN apt install gstreamer1.0-plugins-bad gstreamer1.0-libav gstreamer1.0-gl -y
RUN apt install libqt5gui5 -y
RUN apt install libfuse2 fuse -y
WORKDIR /home/ubuntu
RUN wget https://d176tv9ibo4jno.cloudfront.net/latest/QGroundControl-x86_64.AppImage && \
    chmod +x ./QGroundControl-x86_64.AppImage && \
    usermod -a -G dialout ubuntu

# Install and configure tmux
# tmux
RUN apt install tmux -y
RUN git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
RUN mkdir ~/tmux && \
    wget https://raw.githubusercontent.com/SasaKuruppuarachchi/SasaKuruppuarachchi/main/.tmux.conf -P ~/ && \
    echo 'alias tmuxsrc="tmux source ~/.tmux.conf"' >> ~/.bashrc

# Configure bash environment
RUN echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc
    # Note: /root/colcon_ws is not created; remove or create it if needed
    # echo 'source /root/colcon_ws/install/setup.sh' >> ~/.bashrc

# Clean up
RUN apt-get clean && rm -rf /var/lib/apt/lists/*


ENTRYPOINT ["/bin/bash"]